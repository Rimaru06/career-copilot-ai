generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resumes Resume[]
}

model Resume {
  id            String   @id @default(cuid())
  userId        String
  title         String
  storageKey    String
  fileType      String
  isPrimary     Boolean  @default(false)
  parserVersion String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  education   Education[]
  experiences Experience[]
  projects    Project[]
}

model Education {
  id                  String    @id @default(cuid())
  resumeId            String
  institutionName     String
  course              String
  branch              String?
  startDate           DateTime
  endDate             DateTime?
  isCurrentlyPursuing Boolean   @default(false)
  cgpa                Float?

  resume Resume @relation(fields: [resumeId], references: [id])
}

model Experience {
  id          String    @id @default(cuid())
  resumeId    String
  role        String
  companyName String
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  resume  Resume             @relation(fields: [resumeId], references: [id])
  bullets ExperienceBullet[]
}

model ExperienceBullet {
  id           String   @id @default(cuid())
  experienceId String
  content      String
  order        Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  experience Experience @relation(fields: [experienceId], references: [id])

  @@unique([experienceId, order])
}

model Project {
  id          String    @id @default(cuid())
  resumeId    String
  projectName String
  githubUrl   String?
  liveUrl     String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  resume  Resume          @relation(fields: [resumeId], references: [id])
  bullets ProjectBullet[]
  skills  ProjectSkill[]
}

model ProjectBullet {
  id        String   @id @default(cuid())
  projectId String
  content   String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  @@unique([projectId, order])
}

model Skill {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects ProjectSkill[]
}

model ProjectSkill {
  projectId String
  skillId   String

  project Project @relation(fields: [projectId], references: [id])
  skill   Skill   @relation(fields: [skillId], references: [id])

  @@id([projectId, skillId])
}
